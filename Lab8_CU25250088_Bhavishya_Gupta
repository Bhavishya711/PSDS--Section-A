''' 3.You are given a weighted, undirected graph with N nodes and M edges.
Find the shortest path from node 1 to node N such that the path uses at most K edges.
If no such path exists, output -1.'''

'''
N, M, K = map(int, input("Enter N, M and K: ").split())

edges = []

for _ in range(M):
    u, v, w = map(int, input().split())
    edges.append((u, v, w))

INF = float('inf')
