dist[1] = 0

# Use at most K edges
for _ in range(K):
    new_dist = dist.copy()

    for u, v, w in edges:
        if dist[u] != INF:
            new_dist[v] = min(new_dist[v], dist[u] + w)

        if dist[v] != INF:
            new_dist[u] = min(new_dist[u], dist[v] + w)

    dist = new_dist

if dist[N] == INF:
    print(-1)
else:
    print("Minimum path weight:", dist[N])

